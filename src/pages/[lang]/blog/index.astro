---
import Base from '../../../layouts/Base.astro';
import Rule from '../../../components/Rule.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PostRow from '../../../components/PostRow.astro';
import { languages, ui, type Lang } from '../../../i18n';
import { getWritingWithFallback } from '../../../lib/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const copy = {
  en: {
    title: 'Notes from the road.',
    lead: 'Texts about learning, career transitions and the things I run into outside of code.',
    blog: ['Blog', 'Essays and experiences.'],
    notes: ['Notes', 'Reviews.'],
    reserved: 'Page reserved for future reviews about books, travels and culture in general.',
  },
  pt: {
    title: 'Anotações da estrada.',
    lead: 'Textos sobre aprendizado, transição de carreira e o que encontro pelo caminho fora do código.',
    blog: ['Blog', 'Ensaios e experiências.'],
    notes: ['Notas', 'Resenhas.'],
    reserved: 'Página reservada para futuras resenhas de livros, viagens e cultura no geral.',
  },
}[lang];

const all = await getWritingWithFallback(lang);
const posts = all.filter((x) => x.entry.data.category === 'post');
const notes = all.filter((x) => x.entry.data.category === 'note');
---

<Base lang={lang} title={t.nav.writing} description={copy.lead} path="blog">
  <div class="wrap page-head">
    <p class="label">{t.nav.writing}</p>
    <h1 class="display">{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
  </div>

  <Rule eq="friedmann" lang={lang} />
  <section class="section">
    <div class="wrap">
      <SectionHead letter="α" label={copy.blog[0]} title={copy.blog[1]} />
      {posts.map((x) => <PostRow entry={x.entry} lang={lang} foreign={x.foreign} />)}
    </div>
  </section>

  <section class="section" id="notes">
    <div class="wrap">
      <SectionHead letter="β" label={copy.notes[0]} title={copy.notes[1]} />
      {notes.map((x) => <PostRow entry={x.entry} lang={lang} foreign={x.foreign} />)}
      {notes.length === 0 && <p class="reserved reveal">{copy.reserved}</p>}
    </div>
  </section>
</Base>

<style>
  .reserved {
    margin: 0;
    padding: 1.5rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
  }
</style>
