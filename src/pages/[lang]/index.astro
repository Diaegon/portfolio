---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Rule from '../../components/Rule.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostRow from '../../components/PostRow.astro';
import Eq from '../../components/Eq.astro';
import { languages, page, ui, type Lang } from '../../i18n';
import { pattern, stats, stack, worldline, quote, sections } from '../../data/home';
import { getProjects, getWritingWithFallback } from '../../lib/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const p = pattern[lang];
const s = stack[lang];
const wl = worldline[lang];
const sec = sections[lang];

const featured = (await getProjects(lang)).filter((x) => x.data.featured);
const primary = featured.find((x) => x.data.primary);
const others = featured.filter((x) => !x.data.primary);
const posts = (await getWritingWithFallback(lang)).slice(0, 3);
---

<Base lang={lang}>
  <Hero lang={lang} />

  <!-- α · the pattern -->
  <Rule eq="efe" lang={lang} />
  <section class="section">
    <div class="wrap">
      <SectionHead letter="α" label={p.label} title={p.title} />
      <div class="pattern__intro reveal">
        {p.paragraphs.map((x) => <p>{x}</p>)}
      </div>

      <div class="pattern" role="table" aria-label={p.label}>
        <div class="pattern__head" role="row">
          {p.columns.map((c) => <span role="columnheader" class="label label--dim">{c}</span>)}
        </div>
        {
          p.rows.map((r, i) => (
            <div class="pattern__row reveal" role="row" style={`--delay:${i * 0.08}s`}>
              <div role="cell" data-col={p.columns[0]}>
                <span class="pattern__from">{r.from}</span>
              </div>
              <div role="cell" data-col={p.columns[1]} class="pattern__friction">
                {r.friction}
              </div>
              <div role="cell" data-col={p.columns[2]} class="pattern__built">
                {r.built}
                {r.link && (
                  <a class="more" href={page(lang, r.link)}>
                    {t.readMore}
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <dl class="stats">
        {
          stats[lang].map((x, i) => (
            <div class="reveal" style={`--delay:${i * 0.06}s`}>
              <dt>{x.label}</dt>
              <dd>{x.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- β · selected work -->
  <Rule eq="cov" lang={lang} />
  <section class="section">
    <div class="wrap">
      <SectionHead letter="β" label={sec.work[0]} title={sec.work[1]} />
      <div class="work">
        {primary && <ProjectCard project={primary} lang={lang} large />}
        <div class="work__grid">
          {others.map((x, i) => <ProjectCard project={x} lang={lang} showImage={false} delay={i * 0.08} />)}
        </div>
      </div>
      <p class="after"><a class="more" href={page(lang, 'projects')}>{t.allProjects}</a></p>
    </div>
  </section>

  <!-- γ · stack -->
  <Rule eq="christoffel" lang={lang} />
  <section class="section">
    <div class="wrap">
      <SectionHead letter="γ" label={s.label} title={s.title} />
      <div class="stack">
        {
          s.groups.map((g, i) => (
            <div class="stack__col reveal" style={`--delay:${i * 0.06}s`}>
              <h3 class="label">{g.name}</h3>
              <ul>
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="motto reveal">{s.motto}</p>
    </div>
  </section>

  <!-- δ · worldline -->
  <Rule eq="geodesic" lang={lang} />
  <section class="section">
    <div class="wrap">
      <SectionHead letter="δ" label={wl.label} title={wl.title} />
      <ol class="line">
        {
          wl.events.map((e) => (
            <li class:list={['reveal', { now: e.now }]}>
              <span class="line__year">{e.year}</span>
              <div>
                <h3 class="h3">{e.title}</h3>
                {e.notes.map((n) => <p>{n}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="after"><a class="more" href={page(lang, 'experience')}>{t.fullExperience}</a></p>

      <figure class="quote reveal">
        <blockquote lang="en">“{quote.text}”</blockquote>
        <figcaption>— {quote.author}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ε · writing -->
  <Rule eq="friedmann" lang={lang} />
  <section class="section">
    <div class="wrap">
      <SectionHead letter="ε" label={sec.writing[0]} title={sec.writing[1]} />
      {posts.map((x) => <PostRow entry={x.entry} lang={lang} foreign={x.foreign} />)}
      <p class="after"><a class="more" href={page(lang, 'blog')}>{t.allWriting}</a></p>
    </div>
  </section>
</Base>

<style>
  .after {
    margin: 2rem 0 0;
  }

  /* pattern */
  .pattern__intro {
    max-width: 44rem;
    font-size: 1.12rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .pattern__head,
  .pattern__row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 1rem 2.5rem;
  }
  .pattern__head {
    padding-bottom: 0.9rem;
  }
  .pattern__row {
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .pattern__row::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 3rem;
    height: 1px;
    background: var(--crimson);
  }
  .pattern__from {
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.2;
    color: var(--text);
  }
  .pattern__friction {
    color: var(--muted);
  }
  .pattern__built {
    color: var(--body);
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }
  @media (max-width: 820px) {
    .pattern__head {
      display: none;
    }
    .pattern__row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .pattern__row > [data-col]:not(:first-child)::before {
      content: attr(data-col);
      display: block;
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--dim);
      margin-bottom: 0.3rem;
    }
  }

  /* stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    border-block: 1px solid var(--line);
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 1.6rem 1.25rem 1.6rem 0;
  }
  .stats > div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }
  .stats dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 2.9vw, 2.5rem);
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }
  .stats dt {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats > div,
    .stats > div + div {
      padding: 1.25rem 1rem 1.25rem 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .stats > div:nth-child(-n + 2) {
      border-top: 0;
    }
    .stats > div:first-child {
      grid-column: 1 / -1;
    }
    .stats > div:nth-child(2),
    .stats > div:nth-child(3) {
      border-top: 1px solid var(--line);
    }
  }

  /* work */
  .work {
    display: grid;
    gap: 1.25rem;
  }
  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }

  /* stack */
  .stack {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  .stack__col h3 {
    padding-bottom: 0.9rem;
    position: relative;
    letter-spacing: 0.2em;
  }
  .stack__col h3::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--crimson);
  }
  .stack__col ul {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.92rem;
    color: var(--body);
  }
  @media (max-width: 1000px) {
    .stack {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* "house words" */
  .motto {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 1.5rem 0;
    border-block: 1px solid var(--line);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    line-height: 1.2;
    color: var(--text);
    text-align: center;
    text-wrap: balance;
  }

  /* worldline */
  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .line::before {
    content: '';
    position: absolute;
    left: calc(6.5rem + 5px);
    top: 0.9rem;
    bottom: 0.9rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--crimson) 8%, var(--crimson) 92%, transparent);
    opacity: 0.6;
  }
  .line li {
    display: grid;
    grid-template-columns: 6.5rem 11px 1fr;
    gap: 0 1.75rem;
    padding-block: 1.1rem;
    align-items: start;
  }
  .line li::before {
    content: '';
    grid-column: 2;
    grid-row: 1;
    width: 11px;
    height: 11px;
    margin-top: 0.75rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--crimson);
  }
  .line li.now::before {
    background: var(--ember);
    border-color: var(--ember);
    box-shadow: 0 0 0 5px rgba(255, 84, 104, 0.18), 0 0 18px rgba(255, 84, 104, 0.7);
  }
  .line__year {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--dim);
    text-align: right;
    font-variant-numeric: lining-nums;
  }
  .line li.now .line__year {
    color: var(--ember);
  }
  .line li > div {
    grid-column: 3;
  }
  .line p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
  }
  @media (max-width: 620px) {
    .line::before {
      left: 5px;
    }
    .line li {
      grid-template-columns: 11px 1fr;
      gap: 0 1.1rem;
    }
    .line li::before {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-top: 0.5rem;
    }
    .line__year {
      grid-column: 2;
      text-align: left;
      font-size: 1.5rem;
    }
    .line li > div {
      grid-column: 2;
    }
  }

  .quote {
    margin: clamp(3rem, 7vw, 5rem) auto 0;
    max-width: 46rem;
    text-align: center;
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.35;
    color: var(--text);
    text-wrap: balance;
  }
  .quote figcaption {
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ember);
  }
</style>
