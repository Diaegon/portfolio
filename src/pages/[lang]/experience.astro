---
import Base from '../../layouts/Base.astro';
import Rule from '../../components/Rule.astro';
import { languages, page, type Lang } from '../../i18n';
import { intro, roles, education, extras } from '../../data/experience';
import { stats } from '../../data/home';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const i = intro[lang];
const edu = education[lang];
const ex = extras[lang];
---

<Base lang={lang} title={i.label} description={i.lead[0]} path="experience">
  <div class="wrap page-head">
    <p class="label">{i.label}</p>
    <h1 class="display">{i.title}</h1>
    {i.lead.map((p) => <p class="lead">{p}</p>)}
  </div>

  <div class="wrap">
    <dl class="nums">
      {
        stats[lang].map((x) => (
          <div>
            <dt>{x.label}</dt>
            <dd>{x.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <Rule eq="riemann" lang={lang} />

  <section class="section">
    <div class="wrap roles">
      {
        roles[lang].map((r) => (
          <article class="role reveal">
            <div class="role__side">
              <p class="role__period">{r.period}</p>
              <p class="role__company">{r.company}</p>
            </div>
            <div class="role__main">
              <h2 class="h2">{r.title}</h2>
              <p class="role__context">{r.context}</p>
              <ul class="role__list">
                {r.highlights.map((h) => (
                  <li>
                    {h.head && <strong>{h.head}. </strong>}
                    {h.text}
                  </li>
                ))}
              </ul>
              <ul class="chips">
                {r.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              {r.link && (
                <p class="role__link">
                  <a class="more" href={page(lang, r.link.path)}>
                    {r.link.label}
                  </a>
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <Rule eq="geodesic" lang={lang} />

  <section class="section">
    <div class="wrap cols">
      <div class="reveal">
        <h2 class="label">{edu.label}</h2>
        <ul class="edu">
          {
            edu.items.map((e) => (
              <li>
                <span class="edu__period">{e.period}</span>
                <span class="edu__course">{e.course}</span>
                <span class="edu__school">{e.school}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal">
        <h2 class="label">{ex.languagesLabel}</h2>
        <ul class="plain">
          {ex.languages.map((l) => <li>{l}</li>)}
        </ul>
        <h2 class="label second">{ex.domainsLabel}</h2>
        <ul class="plain">
          {ex.domains.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head .lead + .lead {
    margin-top: 1rem;
  }
  .nums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 2rem;
    margin: 1rem 0 clamp(2rem, 5vw, 3.5rem);
    padding-block: 1.75rem;
    border-block: 1px solid var(--line);
  }
  .nums > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .nums dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }
  .nums dt {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .roles {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }
  .role {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .role::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 13rem;
    max-width: 40%;
    height: 1px;
    background: var(--crimson);
  }
  .role__side {
    position: sticky;
    top: 5.5rem;
    align-self: start;
  }
  .role__period {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 0.5rem 0 0.6rem;
  }
  .role__company {
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.15;
    color: var(--text);
    margin: 0;
  }
  .role__main {
    max-width: 46rem;
  }
  .role__main .h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .role__context {
    color: var(--muted);
    margin: 0.9rem 0 0;
  }
  .role__list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 1.75rem;
    display: grid;
    gap: 1rem;
  }
  .role__list li {
    padding-left: 1.4rem;
    position: relative;
    line-height: 1.65;
  }
  .role__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.8rem;
    height: 2px;
    background: var(--crimson);
  }
  .role__link {
    margin: 1.5rem 0 0;
  }
  @media (max-width: 820px) {
    .role {
      grid-template-columns: 1fr;
    }
    .role__side {
      position: static;
    }
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 6vw, 5rem);
  }
  .cols .label {
    font-family: var(--mono);
    margin-bottom: 1.25rem;
  }
  .cols .second {
    margin-top: 2.5rem;
  }
  .edu,
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .edu li {
    display: grid;
    gap: 0.15rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .edu__period {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--dim);
  }
  .edu__course {
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.2;
    color: var(--text);
  }
  .edu__school {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .plain li {
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.98rem;
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
