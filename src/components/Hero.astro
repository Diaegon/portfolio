---
import Eq from './Eq.astro';
import { hero } from '../data/home';
import { href, page, ui, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = hero[lang];
---

<section class="hero">
  <img class="hero__fig hero__fig--l" src={href('/images/hero-left.webp')} alt="" width="440" height="880" />
  <img class="hero__fig hero__fig--r" src={href('/images/hero-right.webp')} alt="" width="380" height="880" />
  <canvas class="hero__grid" aria-hidden="true"></canvas>

  <div class="wrap hero__in">
    <p class="label hero__eyebrow">
      {h.eyebrow.map((e, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<span>{e}</span></>)}
    </p>
    <h1 class="display">Diêgo Tavares Canafistula</h1>
    <div class="hero__hr" aria-hidden="true"></div>
    <p class="lead hero__lead">
      {h.lead} <strong>{h.leadStrong}</strong>
    </p>
    <ul class="hero__facts">
      {h.facts.map((f) => <li>{f}</li>)}
    </ul>
    <div class="hero__cta">
      <a class="btn btn--solid" href={page(lang, 'projects')}>
        {h.ctaWork} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn" href="#contact">{h.ctaContact}</a>
    </div>
    <div class="hero__law">
      <Eq name="tensor" />
      <p>{ui[lang].footerLaw}</p>
    </div>
  </div>
</section>

<script>
  // Spacetime grid: a faint coordinate grid that bends toward a mass.
  // The mass drifts on its own and follows the pointer while it is over the hero.
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__grid');
  const hero = canvas?.parentElement;
  const ctx = canvas?.getContext('2d');

  if (canvas && hero && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GAP = 46;
    const STEP = 14;
    const SOFT = 150 * 150;
    let w = 0;
    let h = 0;
    let mass = { x: 0, y: 0 };
    let target: { x: number; y: number } | null = null;
    let visible = true;
    let raf = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const warp = (x: number, y: number): [number, number] => {
      const dx = x - mass.x;
      const dy = y - mass.y;
      const pull = (0.6 * SOFT) / (dx * dx + dy * dy + SOFT);
      return [x - dx * pull, y - dy * pull];
    };

    const draw = (t: number) => {
      if (!target) {
        // idle orbit, slow enough to read as drift
        const k = t / 9000;
        mass.x += (w * (0.5 + 0.26 * Math.cos(k)) - mass.x) * 0.02;
        mass.y += (h * (0.48 + 0.2 * Math.sin(k * 1.3)) - mass.y) * 0.02;
      } else {
        mass.x += (target.x - mass.x) * 0.07;
        mass.y += (target.y - mass.y) * 0.07;
      }

      ctx.clearRect(0, 0, w, h);
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(200, 30, 60, 0.16)';
      ctx.beginPath();
      for (let y = -GAP; y <= h + GAP; y += GAP) {
        for (let x = -GAP; x <= w + GAP; x += STEP) {
          const [px, py] = warp(x, y);
          if (x === -GAP) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
      }
      for (let x = -GAP; x <= w + GAP; x += GAP) {
        for (let y = -GAP; y <= h + GAP; y += STEP) {
          const [px, py] = warp(x, y);
          if (y === -GAP) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
      }
      ctx.stroke();

      const glow = ctx.createRadialGradient(mass.x, mass.y, 0, mass.x, mass.y, 170);
      glow.addColorStop(0, 'rgba(255, 84, 104, 0.16)');
      glow.addColorStop(1, 'rgba(255, 84, 104, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(mass.x - 170, mass.y - 170, 340, 340);
    };

    const loop = (t: number) => {
      draw(t);
      if (visible) raf = requestAnimationFrame(loop);
    };

    resize();
    mass = { x: w * 0.72, y: h * 0.45 };
    draw(0);

    new ResizeObserver(() => {
      resize();
      draw(performance.now());
    }).observe(hero);

    if (!reduce) {
      hero.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'touch') return;
        const r = hero.getBoundingClientRect();
        target = { x: e.clientX - r.left, y: e.clientY - r.top };
      });
      hero.addEventListener('pointerleave', () => (target = null));
      new IntersectionObserver(([entry]) => {
        const was = visible;
        visible = entry.isIntersecting;
        if (visible && !was) raf = requestAnimationFrame(loop);
        if (!visible) cancelAnimationFrame(raf);
      }).observe(hero);
      raf = requestAnimationFrame(loop);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: min(calc(100svh - 3.75rem), 900px);
    padding-block: clamp(3rem, 8vw, 5.5rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 55% 60% at 50% 45%, rgba(200, 30, 60, 0.16), transparent 70%),
      var(--bg-sunken);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    mask-image: radial-gradient(ellipse 75% 85% at 50% 50%, #000 35%, transparent 100%);
  }
  .hero__fig {
    position: absolute;
    top: 0;
    height: 100%;
    width: auto;
    max-width: none;
    z-index: -2;
    pointer-events: none;
    user-select: none;
  }
  .hero__fig--l {
    left: 0;
    mask-image: linear-gradient(90deg, #000 55%, transparent), linear-gradient(0deg, transparent, #000 14%);
    mask-composite: intersect;
  }
  .hero__fig--r {
    right: 0;
    mask-image: linear-gradient(270deg, #000 55%, transparent), linear-gradient(0deg, transparent, #000 14%);
    mask-composite: intersect;
  }
  .hero__in {
    max-width: calc(46rem + 2 * var(--gutter));
  }
  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-bottom: 1.4rem;
    font-size: clamp(0.66rem, 1.6vw, 0.8rem);
  }
  .hero__hr {
    height: 1px;
    margin-block: clamp(1.25rem, 3vw, 2rem);
    background: linear-gradient(90deg, var(--crimson), rgba(200, 30, 60, 0.5) 70%, transparent);
  }
  .hero__lead strong {
    color: #fff;
  }
  .hero__facts {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    gap: 0.55rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .hero__facts li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.75rem;
  }
  .hero__facts li::before {
    content: '';
    height: 2px;
    margin-top: 0.7em;
    background: var(--crimson);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .hero__law {
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    border-left: 3px solid var(--crimson);
    padding-left: 1.1rem;
    font-size: clamp(1.15rem, 3.2vw, 1.7rem);
  }
  .hero__law p {
    margin: 0.4rem 0 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  /* the figures need room on both sides of the text column */
  @media (max-width: 1320px) {
    .hero__fig--l {
      display: none;
    }
    .hero__fig--r {
      opacity: 0.55;
    }
    .hero__in {
      margin-left: max(0px, calc((100vw - var(--wrap) - 2 * var(--gutter)) / 2));
    }
  }
  @media (max-width: 900px) {
    .hero__fig--r {
      opacity: 0.28;
      right: -4rem;
    }
  }
</style>
