---
// Greek letter + mono label + serif title. The Greek letters number the sections.
interface Props {
  letter?: string;
  label: string;
  title: string;
  as?: 'h1' | 'h2';
}
const { letter, label, title, as: Tag = 'h2' } = Astro.props;
---

<header class="shead reveal">
  <p class="label">
    {letter && <span class="shead__letter" aria-hidden="true">{letter}</span>}
    {label}
  </p>
  <Tag class="h2">{title}</Tag>
  <slot />
</header>

<style>
  .shead {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    max-width: 46rem;
  }
  .shead .label {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .shead__letter {
    font-family: var(--serif);
    font-size: 1.7rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--crimson);
    line-height: 1;
  }
</style>
