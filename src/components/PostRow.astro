---
import { formatDate, page, ui, type Lang } from '../i18n';
import { slugOf, langOf, readingMinutes, type Writing } from '../lib/content';
interface Props {
  entry: Writing;
  lang: Lang;
  foreign?: boolean;
}
const { entry, lang, foreign = false } = Astro.props;
const entryLang = langOf(entry);
const mins = readingMinutes(entry.body);
---

<article class="post reveal">
  <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
  <div>
    <h3 class="h3">
      <a href={page(entryLang, `blog/${slugOf(entry)}`)} hreflang={foreign ? entryLang : undefined}>
        {entry.data.title}
      </a>
    </h3>
    {entry.data.description && <p>{entry.data.description}</p>}
    <p class="post__meta">
      {mins} min
      {foreign && <span class="post__lang">{ui[lang].onlyIn[entryLang]}</span>}
    </p>
  </div>
</article>

<style>
  .post {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .post:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  time,
  .post__meta {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  time {
    padding-top: 0.55rem;
  }
  .post a {
    text-decoration: none;
    background: linear-gradient(var(--crimson), var(--crimson)) no-repeat 0 100% / 0 1px;
    transition: background-size 0.3s;
  }
  .post a:hover {
    background-size: 100% 1px;
  }
  .post p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    max-width: 40rem;
  }
  .post__meta {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .post__lang {
    color: var(--ember);
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    padding: 0.1rem 0.45rem;
  }
  @media (max-width: 720px) {
    .post {
      grid-template-columns: 1fr;
    }
    time {
      padding-top: 0;
    }
  }
</style>
