---
// Section divider: a crimson rule carrying one equation, like the ones in the README.
import { equations, type EquationKey } from '../data/equations';
import type { Lang } from '../i18n';
interface Props {
  eq: EquationKey;
  lang: Lang;
}
const { eq, lang } = Astro.props;
---

<div class="rule reveal" role="separator" aria-label={equations[eq].name[lang]}>
  <div class="rule__chip" aria-hidden="true">
    <span class="eq" set:html={equations[eq].html} />
  </div>
  <div class="rule__line" aria-hidden="true"></div>
  <span class="rule__name" aria-hidden="true">{equations[eq].name[lang]}</span>
</div>

<style>
  .rule {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: 1rem;
  }
  .rule__chip {
    flex: 0 1 auto;
    min-width: 0;
    border-left: 3px solid var(--crimson);
    padding: 0.5rem 1.75rem 0.5rem 1rem;
    font-size: clamp(0.95rem, 2.4vw, 1.3rem);
    overflow: hidden;
    mask-image: linear-gradient(90deg, #000 calc(100% - 1.5rem), transparent);
  }
  .rule__line {
    flex: 1 1 3rem;
    min-width: 2rem;
    height: 1px;
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, rgba(200, 30, 60, 0.55), rgba(200, 30, 60, 0.55) 70%, transparent);
  }
  /* a pulse of light travelling along the rule when it enters the page */
  .rule__line::after {
    content: '';
    position: absolute;
    inset: -1px auto -1px 0;
    width: 30%;
    background: linear-gradient(90deg, transparent, var(--ember), transparent);
    transform: translateX(-110%);
  }
  :global(.js) .rule.in .rule__line::after {
    animation: sweep 1.8s 0.2s ease-out forwards;
  }
  @keyframes sweep {
    to {
      transform: translateX(440%);
    }
  }
  .rule__name {
    flex: none;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }
  @media (max-width: 720px) {
    .rule__name {
      display: none;
    }
  }
</style>
