---
// Fixed starfield behind every page. Seeded so the sky is the same on every build.
let seed = 20110817;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const stars = Array.from({ length: 170 }, () => ({
  x: (rand() * 1600).toFixed(1),
  y: (rand() * 1000).toFixed(1),
  r: (0.4 + rand() * 1.1).toFixed(2),
  o: (0.05 + rand() * 0.4).toFixed(2),
  red: rand() > 0.93,
}));
---

<div class="sky" aria-hidden="true">
  <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill={s.red ? '#FF5468' : '#fff'} opacity={s.o} />)}
  </svg>
</div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 45% at 50% -5%, rgba(200, 30, 60, 0.13), transparent 70%),
      radial-gradient(ellipse 50% 40% at 100% 100%, rgba(200, 30, 60, 0.05), transparent 70%),
      var(--bg);
  }
  svg {
    width: 100%;
    height: 100%;
  }
</style>
